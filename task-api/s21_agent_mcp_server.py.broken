def extract_key_points(description: str) -> str:
    """Extract key points from task description."""
    import re

    if not description:
        return ""

    lines = description.split('\n')
    key_points = []

    for line in lines:
        line = line.strip()
        # Look for numbered items, dates, emails, important deadlines
        if re.match(r'^\d+\.', line) or re.search(r'\d{2}\.\d{2}\.\d{4}', line) or '@' in line:
            key_points.append(line)

    if key_points:
        return ' '.join(key_points[:10])

    return ""


