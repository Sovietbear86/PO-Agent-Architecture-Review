def extract_assignee_from_query(query: str) -> Optional[str]:
    """Извлечь имя исполнителя из запроса"""
    query_lower = query.lower()

    for member in team_agent.team_members:
        # Проверяем login (без точки и расширения) - приоритет для поиска
        login = member.login.split('.')[0].lower() if '.' in member.login else member.login.lower()

        # Проверяем фамилию (первая часть полного имени)
        full_name_parts = member.full_name.split()
        surname = full_name_parts[0].lower() if full_name_parts else ''

        # Проверяем полное имя (без отчества) - Last First (as in tasks)
        first_name = full_name_parts[1] if len(full_name_parts) > 1 else ''
        patronymic = full_name_parts[2] if len(full_name_parts) > 2 else ''

        if login and login in query_lower:
            # Return short name for search in SWTR (FastAPI expects "Last First" without patronymic)
            return f"{full_name_parts[0]} {first_name}" if len(full_name_parts) > 1 else member.full_name

        # Check full name in genitive case FIRST (e.g., "Гаранина Родиона", "Кондратчиковой Полины")
        # Build genitive for surname
        surname_genitive = None
        if surname.endswith('ова') or surname.endswith('ева'):
            surname_genitive = surname[:-2] + 'ой'
        elif surname.endswith('ия'):
            surname_genitive = surname[:-2] + 'ой'
        elif surname.endswith('а') and len(surname) > 1 and surname[-2] not in 'аяоуыэюи':
            surname_genitive = surname[:-1] + 'а'
        else:
            surname_genitive = surname + 'а'

        # Build genitive for first name
        first_name_genitive = None
        if first_name.endswith('а'):
            first_name_genitive = first_name[:-1] + 'ы'
        elif first_name.endswith('ий') or first_name.endswith('й'):
            # Elena -> Elena, Sergey -> Sergey's
            first_name_genitive = first_name[:-1] + 'я'
        elif first_name.endswith('ион'):
            # Rodion -> Rodiona
            first_name_genitive = first_name[:-2] + 'она'
        elif first_name.endswith('н'):
            # Ivan -> Ivana, Petr -> Petra
            first_name_genitive = first_name + 'а'
        else:
            first_name_genitive = first_name + 'а'

        # Check full genitive name (case-insensitive)
        if surname_genitive and first_name_genitive:
            full_genitive = f"{surname_genitive} {first_name_genitive}"
            if full_genitive.lower() in query_lower:
                return f"{full_name_parts[0]} {first_name}" if len(full_name_parts) > 1 else member.full_name

        # Check surname in genitive case (case-insensitive)
        if surname_genitive and surname_genitive.lower() in query_lower:
            return f"{full_name_parts[0]} {first_name}" if len(full_name_parts) > 1 else member.full_name

        # Check first name in genitive case (case-insensitive)
        if first_name_genitive and first_name_genitive.lower() in query_lower:
            return f"{full_name_parts[0]} {first_name}" if len(full_name_parts) > 1 else member.full_name

        # Check surname with different cases (nominative) - after genitive
        if surname and surname in query_lower:
            # Return short name for search in SWTR
            return f"{full_name_parts[0]} {first_name}" if len(full_name_parts) > 1 else member.full_name

        if first_name and first_name.lower() in query_lower:
            # Return short name for search in SWTR
            return f"{full_name_parts[0]} {first_name}" if len(full_name_parts) > 1 else member.full_name

    return None


def start_mcp_server() -> subprocess.Popen:
    """Start the MCP server process for SWTR."""
    token = os.environ.get('TOKEN')
    if not token:
        try:
            with open(os.path.expanduser('~/.config/swtr/api_key'), 'r') as f:
                token = f.read().strip()
        except:
            pass

    base_url = os.environ.get('BASE_URL', 'https://portal.works.prod.sbt/swtr')
    env = os.environ.copy()
    env['TOKEN'] = token
    env['BASE_URL'] = base_url
    env['PORT'] = '0'

    script_path = os.path.join(os.path.dirname(__file__), '..', 'mcp-swtr', 'mcp_server.py')
    python_path = os.path.join(os.path.dirname(__file__), '..', 'mcp-swtr', '.venv', 'bin', 'python')

    return subprocess.Popen(
        [python_path, script_path],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        env=env,
        text=True,
        bufsize=1
    )


def send_mcp_request(proc: subprocess.Popen, method: str, params: dict) -> dict:
    """Send MCP request and wait for response."""
    request = {
        'jsonrpc': '2.0',
        'method': method,
        'params': params,
        'id': 1
    }

    proc.stdin.write(json.dumps(request) + '\n')
    proc.stdin.flush()

    response = proc.stdout.readline()
    return json.loads(response)


class SearchRequest(BaseModel):
    """Request for task search."""
    query: str = Field(..., description="Search query")
    filters: dict[str, Any] | None = Field(None, description="Optional filters (status, assignee, project)")
    limit: int = Field(50, ge=1, le=100, description="Maximum number of results")


class TaskIdRequest(BaseModel):
    """Request for task by ID."""
    task_id: str = Field(..., description="Task ID")


class TaskUrlRequest(BaseModel):
    """Request for task by URL."""
    url: str = Field(..., description="SWTR task URL")


class QualityCriteriaRequest(BaseModel):
    """Request for quality assessment."""
    task_id: str = Field(..., description="Task ID to assess")
    criteria: list[dict[str, Any]] = Field(
        default=[
            {"name": "цель", "weight": 20},
            {"name": "критерии приемки", "weight": 30},
            {"name": "зависимости", "weight": 20},
            {"name": "риски", "weight": 20},
            {"name": "вопросы", "weight": 10},
        ],
        description="Quality criteria with weights",
    )


