# PO Agent Platform v2.1 Environment Variables

# Application
APP_NAME=po-agent-platform-v2
APP_VERSION=0.1.0
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8004

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
CORRELATION_ID_HEADER=X-Request-ID

# Harness source boundary
# fake     = deterministic local fixtures
# task-api = production-facing async adapter over task-api/SWTR
AS21_MODE=fake
TASK_API_BASE_URL=http://localhost:8003
TASK_API_TIMEOUT_SECONDS=30
# Optional explicit path to the canonical team profile file. If omitted in task-api
# mode, runtime_factory probes ../task-api/config/team_members.yaml and task-api/config/team_members.yaml.
TEAM_CONFIG_PATH=

# Legacy/direct SWTR settings retained only for compatibility code paths.
SWTR_BASE_URL=https://portal.works.prod.sbt/swtr
SWTR_TOKEN=

# LLM Provider (OpenAI-compatible). Core metrics/readiness remain deterministic.
LLM_API_BASE_URL=https://api.ai.sbt/v1
LLM_API_KEY=
LLM_MODEL_NAME=qwen-coder-3.7

# Storage
DATABASE_URL=sqlite:///data/app.db
