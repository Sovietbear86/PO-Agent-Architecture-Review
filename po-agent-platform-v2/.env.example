# PO Agent Platform v2.1 Environment Variables

# Application
APP_NAME="po-agent-platform-v2"
APP_VERSION=0.1.0
APP_ENV=development
APP_PORT=8004
APP_HOST=127.0.0.1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
CORRELATION_ID_HEADER=X-Request-ID

# Harness / AS21 runtime
# fake | task-api
AS21_MODE=fake
TASK_API_BASE_URL=http://localhost:8003
TASK_API_TIMEOUT_SECONDS=30
# Enable only certified Agent Core v3 strangler routes; unsupported requests delegate legacy.
PO_AGENT_AGENT_CORE_V3_ENABLED=false
# Optional explicit canonical team profile path. In task-api mode the runtime also
# probes ../task-api/config/team_members.yaml and task-api/config/team_members.yaml.
TEAM_CONFIG_PATH=

# Legacy SWTR variables retained only for legacy/diagnostic components.
SWTR_BASE_URL=https://portal.works.prod.sbt/swtr
SWTR_TOKEN=

# LLM Provider (OpenAI-compatible)
LLM_API_BASE_URL=https://api.ai.sbt/v1
LLM_API_KEY=
LLM_MODEL_NAME=qwen-coder-3.7

# Storage
DATABASE_URL=sqlite:///data/app.db
