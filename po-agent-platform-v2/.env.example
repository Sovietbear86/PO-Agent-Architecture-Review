# PO Agent Platform v2.1 Environment Variables

# Application
APP_NAME="po-agent-platform-v2"
APP_VERSION=0.1.0
APP_ENV=development
APP_PORT=8004

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Correlation ID
CORRELATION_ID_HEADER=X-Request-ID

# AS21/SWTR Adapter
SWTR_BASE_URL=https://portal.works.prod.sbt/swtr
SWTR_TOKEN=${SWTR_TOKEN:-}

# LLM Provider (OpenAI-compatible)
LLM_API_BASE_URL=${LLM_API_BASE_URL:-https://api.ai.sbt/v1}
LLM_API_KEY=${LLM_API_KEY:-}
LLM_MODEL_NAME=${LLM_MODEL_NAME:-qwen-coder-3.7}

# Storage
DATABASE_URL=sqlite:///data/app.db
