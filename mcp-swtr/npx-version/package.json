{
    "name": "@abac/mcp-swtr",
    "version": "1.3.0",
    "description": "MCP server for SberWorks Task Tracker (stdio, npx)",
    "authors": [
        "redacted@sbertech.ru",
        "redacted@sbertech.ru"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "bin": {
        "mcp-swtr": "./dist/index.js"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --banner:js=\"#!/usr/bin/env node\" && chmod +x dist/index.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepublishOnly": "npm run build",
        "link": "bash scripts/global-link.sh",
        "unlink": "rm -f \"$HOME/.local/bin/mcp-swtr\" \"$HOME/bin/mcp-swtr\" && echo '✓ Unlinked'"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.29.0",
        "zod": "^3.24.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.0.0",
        "esbuild": "^0.28.0",
        "eslint": "^10.4.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.8.3",
        "typescript": "^5.7.0",
        "typescript-eslint": "^8.60.0"
    },
    "license": "MIT"
}
