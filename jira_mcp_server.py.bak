#!/usr/bin/env python3
"""Jira MCP Server - Using PLATFORM_SESSION cookie authentication with Session."""

import os
import json
import requests
from starlette.applications import Starlette
from starlette.responses import JSONResponse
from starlette.routing import Route
from starlette.requests import Request

JIRA_URL = 'https://portal.works.prod.sbt'
JIRA_PLATFORM_SESSION = os.environ.get('JIRA_PLATFORM_SESSION', '')

JIRA_ENABLED = False
JIRA_SESSION = None

print("=" * 60)
print("JIRA MCP SERVER - Using PLATFORM_SESSION Cookie")
print("=" * 60)
print(f"JIRA_URL: {JIRA_URL}")
print(f"Cookie configured: {'Yes' if JIRA_PLATFORM_SESSION else 'No'}")
print()


async def health_endpoint(request):
    """Health check endpoint."""
    return JSONResponse({
        "status": "healthy",
        "server": "Task Tracker MCP Server",
        "version": "1.0.0",
        "jira_connected": JIRA_ENABLED
    })


def get_jira_session():
    """Get or create Jira session with PLATFORM_SESSION cookie."""
    global JIRA_SESSION
    if JIRA_SESSION is None:
        JIRA_SESSION = requests.Session()
        JIRA_SESSION.headers.update({
            'Accept': 'application/json',
            'x-ssd-mode': 'works'
        })
    return JIRA_SESSION


def jira_request(session, method, url, **kwargs):
    """Make Jira request with verify=False."""
    return session.request(method, url, verify=False, **kwargs)


async def set_cookie_endpoint(request: Request):
    """Set Jira PLATFORM_SESSION cookie."""
    try:
        data = await request.json()
        cookie = data.get('platform_session')

        if not cookie:
            return JSONResponse({
                "error": "Missing platform_session parameter"
            }, status_code=400)

        global JIRA_PLATFORM_SESSION, JIRA_ENABLED, JIRA_SESSION
        JIRA_PLATFORM_SESSION = cookie

        # Create new session with cookie
        JIRA_SESSION = requests.Session()
        JIRA_SESSION.verify = False
        JIRA_SESSION.cookies.set('PLATFORM_SESSION', cookie, domain='portal.works.prod.sbt', path='/')
        JIRA_SESSION.headers.update({
            'Accept': 'application/json',
            'x-ssd-mode': 'works'
        })

        try:
            resp = JIRA_SESSION.get(f"{JIRA_URL}/rest/api/2/serverInfo")
            if resp.status_code == 200:
                JIRA_ENABLED = True
                server_data = resp.json()

                return JSONResponse({
                    "status": "success",
                    "message": f"Connected to {server_data['serverTitle']} v{server_data['version']}"
                })
            else:
                return JSONResponse({
                    "error": f"Failed to connect: HTTP {resp.status_code}"
                }, status_code=401)
        except Exception as e:
            return JSONResponse({
                "error": str(e)
            }, status_code=500)
    except Exception as e:
        return JSONResponse({
            "error": str(e)
        }, status_code=500)


async def mcp_endpoint(request):
    """Handle MCP requests."""
    try:
        data = await request.json()
        method = data.get("method", "")
        params = data.get("params", {})

        if method == "tools/list":
            return JSONResponse({
                "jsonrpc": "2.0",
                "id": data.get("id"),
                "result": {
                    "tools": [
                        {
                            "name": "get_task",
                            "description": "Get a task by its Jira key",
                            "inputSchema": {
                                "type": "object",
                                "properties": {
                                    "task_key": {"type": "string", "description": "Jira issue key like WMB-29995"}
                                },
                                "required": ["task_key"]
                            }
                        },
                        {
                            "name": "search_tasks",
                            "description": "Search for tasks with JQL query",
                            "inputSchema": {
                                "type": "object",
                                "properties": {
                                    "jql": {"type": "string", "description": "JQL query (e.g., project = WMB)"},
                                    "max_results": {"type": "integer", "description": "Max results (default: 20)"}
                                }
                            }
                        },
                        {
                            "name": "get_my_tasks",
                            "description": "Get tasks assigned to current user",
                            "inputSchema": {
                                "type": "object",
                                "properties": {
                                    "max_results": {"type": "integer", "description": "Max results"}
                                }
                            }
                        }
                    ]
                }
            })

        elif method == "tools/call":
            tool_name = params.get("name")
            arguments = params.get("arguments", {})

            if tool_name == "get_task":
                task_key = arguments.get("task_key", "")
                result_str = await jira_get_task(task_key)
                return JSONResponse({
                    "jsonrpc": "2.0",
                    "id": data.get("id"),
                    "result": {"content": [{"type": "text", "text": result_str}]}
                })

            elif tool_name == "search_tasks":
                jql = arguments.get("jql", "project = WMB ORDER BY created DESC")
                max_results = arguments.get("max_results", 20)
                result_str = await jira_search_tasks(jql, max_results)
                return JSONResponse({
                    "jsonrpc": "2.0",
                    "id": data.get("id"),
                    "result": {"content": [{"type": "text", "text": result_str}]}
                })

            elif tool_name == "get_my_tasks":
                max_results = arguments.get("max_results", 20)
                result_str = await jira_get_my_tasks(max_results)
                return JSONResponse({
                    "jsonrpc": "2.0",
                    "id": data.get("id"),
                    "result": {"content": [{"type": "text", "text": result_str}]}
                })

        return JSONResponse({
            "jsonrpc": "2.0",
            "id": data.get("id"),
            "error": {"code": -32601, "message": "Method not found"}
        })

    except Exception as e:
        return JSONResponse({
            "jsonrpc": "2.0",
            "id": data.get("id"),
            "error": {"code": -32603, "message": str(e)}
        }, status_code=500)


async def jira_get_task(task_key: str) -> str:
    """Get task details from Jira."""
    if not JIRA_ENABLED:
        return f"""Task: {task_key}
Status: Jira not connected

To enable Jira integration:
1. Open browser to https://portal.works.prod.sbt
2. Open DevTools (F12) -> Application -> Cookies -> PLATFORM_SESSION
3. Copy the PLATFORM_SESSION cookie value
4. POST /set-cookie with {"{"}platform_session: "YOUR_COOKIE"{"}"}"""

    try:
        session = get_jira_session()
        session.cookies.set('PLATFORM_SESSION', JIRA_PLATFORM_SESSION, domain='portal.works.prod.sbt', path='/')
        
        resp = session.get(f"{JIRA_URL}/rest/api/2/issue/{task_key}")
        if resp.status_code == 200:
            issue = resp.json()
            fields = issue.get('fields', {})
            return f"""Task: {issue.get('key', task_key)}
Summary: {fields.get('summary', 'N/A')}
Description: {fields.get('description', 'N/A') or 'N/A'}
Status: {fields.get('status', {}).get('name', 'N/A')}
Assignee: {fields.get('assignee', {}).get('displayName', 'Unassigned') if fields.get('assignee') else 'Unassigned'}
Priority: {fields.get('priority', {}).get('name', 'N/A') if fields.get('priority') else 'N/A'}
Created: {fields.get('created', 'N/A')}
Updated: {fields.get('updated', 'N/A')}
Labels: {', '.join(fields.get('labels', [])) if fields.get('labels') else 'None'}"""
        else:
            return f"Error: HTTP {resp.status_code}"
    except Exception as e:
        return f"Error: {str(e)}"


async def jira_search_tasks(jql: str, max_results: int) -> str:
    """Search tasks in Jira."""
    if not JIRA_ENABLED:
        return f"""Searching tasks with JQL: {jql}
Max results: {max_results}
Status: Jira not connected

To enable Jira integration:
1. Open browser to https://portal.works.prod.sbt
2. Open DevTools (F12) -> Application -> Cookies -> PLATFORM_SESSION
3. Copy the PLATFORM_SESSION cookie value
4. POST /set-cookie with {"{"}platform_session: "YOUR_COOKIE"{"}"}"""

    try:
        session = get_jira_session()
        session.cookies.set('PLATFORM_SESSION', JIRA_PLATFORM_SESSION, domain='portal.works.prod.sbt', path='/')
        
        search_data = {
            "jql": jql,
            "maxResults": max_results,
            "fields": ["summary", "status", "created", "priority", "assignee"]
        }

        resp = session.post(f"{JIRA_URL}/rest/api/2/search", json=search_data)
        if resp.status_code == 200:
            result = resp.json()
            issues = result.get('issues', [])
            if not issues:
                return "No tasks found"

            results = []
            for issue in issues:
                key = issue.get('key', 'N/A')
                summary = issue.get('fields', {}).get('summary', 'N/A')
                status = issue.get('fields', {}).get('status', {}).get('name', 'N/A')
                results.append(f"{key}: {summary} [{status}]")
            return f"Found {len(issues)} tasks:\n" + "\n".join(results)
        else:
            return f"Error: HTTP {resp.status_code}"
    except Exception as e:
        return f"Error: {str(e)}"


async def jira_get_my_tasks(max_results: int) -> str:
    """Get tasks assigned to current user."""
    if not JIRA_ENABLED:
        return "Get my tasks - Jira not connected"

    try:
        session = get_jira_session()
        session.cookies.set('PLATFORM_SESSION', JIRA_PLATFORM_SESSION, domain='portal.works.prod.sbt', path='/')
        
        jql = "assignee = currentUser()"
        search_data = {
            "jql": jql,
            "maxResults": max_results,
            "fields": ["summary", "status", "created", "priority"]
        }

        resp = session.post(f"{JIRA_URL}/rest/api/2/search", json=search_data)
        if resp.status_code == 200:
            result = resp.json()
            issues = result.get('issues', [])
            if not issues:
                return "No tasks assigned to you"

            results = []
            for issue in issues:
                key = issue.get('key', 'N/A')
                summary = issue.get('fields', {}).get('summary', 'N/A')
                status = issue.get('fields', {}).get('status', {}).get('name', 'N/A')
                results.append(f"{key}: {summary} [{status}]")
            return f"Found {len(issues)} tasks assigned to you:\n" + "\n".join(results)
        else:
            return f"Error: HTTP {resp.status_code}"
    except Exception as e:
        return f"Error: {str(e)}"


routes = [
    Route("/health", endpoint=health_endpoint),
    Route("/set-cookie", endpoint=set_cookie_endpoint, methods=["POST"]),
    Route("/mcp", endpoint=mcp_endpoint, methods=["GET", "POST"]),
]

app = Starlette(routes=routes)

if __name__ == "__main__":
    import uvicorn
    print("Starting Jira MCP Server on http://localhost:3000/mcp")
    print(f"Jira connected: {JIRA_ENABLED}")
    print()
    print("To enable Jira integration:")
    print("1. Open browser to https://portal.works.prod.sbt")
    print("2. Open DevTools (F12) -> Application -> Cookies -> PLATFORM_SESSION")
    print("3. Copy the PLATFORM_SESSION cookie value")
    print("4. POST /set-cookie with {'platform_session': 'YOUR_COOKIE'}")
    print()
    uvicorn.run(app, host="127.0.0.1", port=3000)
